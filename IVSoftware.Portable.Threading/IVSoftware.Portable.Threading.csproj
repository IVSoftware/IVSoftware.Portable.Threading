<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Title>IVSoftware.Portable.Threading</Title>
		<Description>Design for Testability (DFT) solution featuring an awaitable hook for non-awaitable flows.</Description>
		<PackageTags>portable;net;android;ios;mstest;unittest;design-for-testability;dft</PackageTags>
		<RepositoryUrl>https://github.com/IVSoftware/IVSoftware.Portable.Threading.git</RepositoryUrl>
		<PackageProjectUrl>https://www.nuget.org/packages/IVSoftware.Portable.Threading</PackageProjectUrl>
		<RootNamespace>IVSoftware.Portable.Threading</RootNamespace>
		<TargetFramework>netstandard2.0</TargetFramework>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>IVSoftware, Thomas C. Gregor</Authors>
		<Owner>IVSoftware LLC</Owner>
		<Copyright>Copyright © 2023-2025 IVSoftware LLC</Copyright>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<Version>$(AssemblyVersion)</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>ivs-240909.pfx</AssemblyOriginatorKeyFile>
		<DebugType>embedded</DebugType>
		<BaseVersion>1.3.0</BaseVersion>
		<VersionPrefix>$(BaseVersion)</VersionPrefix>
		<PackageReleaseNotes>
			- OnAwaited can now be called without args.
			- AwaitedEventArgs can now use Collection Initializer syntax.
			- Dictionary support of AwaitedEventArgs is independent.
			- This facilitates using the Args property as a shortcut without disabling the dictionary.
			- The [CallerMemberName] is now VALIDATED to detect calls intended to be args: someString.
		</PackageReleaseNotes>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
